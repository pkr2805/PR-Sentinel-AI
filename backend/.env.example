# Copy to backend/.env and fill in. Never commit .env.

# ─── LLM (required) ────────────────────────────────────────────
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1
# How the final decision is extracted: function_calling | json_schema | json_mode
LLM_STRUCTURED_OUTPUT_METHOD=function_calling
# Max rounds of tool calls the agent may make per PR
LLM_MAX_TOOL_ROUNDS=5

# ─── GitHub (required) ─────────────────────────────────────────
# Token that can read the repos you monitor: https://github.com/settings/tokens
GITHUB_TOKEN=

# ─── Jira (optional) ───────────────────────────────────────────
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_BASE_URL=

# ─── Slack (optional, pick one) ────────────────────────────────
# Slack app: bot token (xoxb-...) and workspace id, used by the Slack MCP server
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
# Or the simple fallback: an incoming webhook URL
SLACK_WEBHOOK_URL=

# ─── App ───────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./sentinel.db
CORS_ORIGINS=["http://localhost:5173"]
