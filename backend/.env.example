# Copy to backend/.env and fill in. Never commit .env.

# ─── LLM (required) ────────────────────────────────────────────
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.1
# How the final decision is extracted: function_calling | json_schema | json_mode
LLM_STRUCTURED_OUTPUT_METHOD=function_calling
# Max rounds of tool calls the LLM judge may make per PR
LLM_MAX_TOOL_ROUNDS=3

# ─── GitHub (required) ─────────────────────────────────────────
# Token that can read the repos you monitor: https://github.com/settings/tokens
GITHUB_TOKEN=

# ─── Jira (optional) ───────────────────────────────────────────
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_BASE_URL=

# ─── Slack (optional, pick one) ────────────────────────────────
# Slack app: bot token (xoxb-...) and workspace id, used by the Slack MCP server
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
# Or the simple fallback: an incoming webhook URL
SLACK_WEBHOOK_URL=

# ─── App ───────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./sentinel.db
CORS_ORIGINS=["http://localhost:5173"]

# ─── GitHub webhooks (optional) ────────────────────────────────
# Set a secret to enable POST /api/webhooks/github (scan on review, CI result, push, comment)
GITHUB_WEBHOOK_SECRET=

# ─── Sentinel behaviour ────────────────────────────────────────
# Dry run: assess and log, but don't comment, label or send Slack. Set to false when you trust it.
SENTINEL_DRY_RUN=true
SENTINEL_STALE_AFTER_DAYS=2
SENTINEL_ESCALATE_AFTER_DAYS=7
SENTINEL_ABANDONED_AFTER_DAYS=21
SENTINEL_REMINDER_INTERVAL_HOURS=24
# No notifications between these UTC hours, e.g. [22,7]
# SENTINEL_QUIET_HOURS_UTC=[22,7]
SENTINEL_REQUIRE_APPROVAL_FOR_ESCALATION=true
SENTINEL_ENABLE_PR_COMMENTS=true
SENTINEL_ENABLE_LABELS=true
SENTINEL_ENABLE_SLACK_DIGEST=true
# Start MCP servers (GitHub/Jira/Slack) as extra tools for the LLM judge
SENTINEL_USE_MCP_TOOLS=true
SENTINEL_MAX_CONCURRENCY=5
